{
  "name": "gym-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "api",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,client \"npm run dev -w api\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "node api/index.js",
    "setup": "node scripts/setup.js",
    "db:migrate": "node api/db/migrate.js",
    "db:seed": "node api/db/seed.js",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "db:demo": "node api/db/demo-fitness.js",
    "admin:create": "node api/db/create-admin.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "concurrently": "10.0.5",
    "prettier": "3.9.6",
    "supertest": "7.2.2"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "uuid": "11.1.1"
  }
}
