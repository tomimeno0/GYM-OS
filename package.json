{
  "name": "gym-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,client \"node --watch index.js\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "node index.js",
    "setup": "node scripts/setup.js",
    "db:migrate": "node config/migrate.js",
    "db:seed": "node config/seed.js",
    "check": "npm run format:check && npm run build",
    "db:demo": "node config/demo-fitness.js",
    "admin:create": "node config/create-admin.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "prettier": "3.9.6"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "mysql2": "3.24.2",
    "nodemailer": "9.1.0",
    "sequelize": "6.37.8",
    "uuid": "11.1.1",
    "zod": "4.5.4"
  }
}
